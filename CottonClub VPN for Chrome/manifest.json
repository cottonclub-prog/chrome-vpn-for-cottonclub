{
  "manifest_version": 3,
  "name": "COTTONCLUB VPN",
  "version": "1.6.14",
  "description": "Hysteria 2 для Google Chrome. Установка для текущего пользователя без прав администратора. Ядро sing-box.",
  "minimum_chrome_version": "120",
  "key": "",
