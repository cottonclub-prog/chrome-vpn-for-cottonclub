{
    "manifest_version":  3,
    "name":  "Chrome VPN for CottonClub",
    "version":  "1.0.0",
    "description":  "VPN для CottonClub в Google Chrome: VLESS и Hysteria 2 с автоматической установкой локального помощника.",
    "minimum_chrome_version":  "120",
    "key":  "",
    "permissions":  [
                        "proxy",
                        "privacy",
                        "nativeMessaging",
                        "storage",
                        "alarms",
                        "clipboardRead"
